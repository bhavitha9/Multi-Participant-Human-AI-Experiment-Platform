# Copy to .env and fill in. docker compose reads it automatically.
ANTHROPIC_API_KEY=
# Optional: override `condition:` from config.yml (three_humans | two_humans_one_ai | one_human_two_ai)
EXPERIMENT_CONDITION=
# Optional: enables researcher export endpoints under /api/admin (send as X-Admin-Token header)
ADMIN_TOKEN=
# Optional: host port for the web app
PORT=3000
